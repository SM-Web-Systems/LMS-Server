NODE_ENV=development
PORT=3001
DATABASE_PATH=./data/student_ms.db

# REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Frontend origin(s) for CORS — comma-separated if you have Vite + LocalWP, e.g.:
# FRONTEND_URL=http://localhost:5173,https://mysite.local
FRONTEND_URL=http://localhost:5173

# Google OAuth (optional — leave empty to disable Google sign-in)
GOOGLE_CLIENT_ID=

# Clerk (optional — primary auth when set; frontend uses Clerk by default)
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=   # or VITE_... in frontend

# WordPress JWT (optional — when set, requests with header X-Auth-Source: wordpress use WP token)
# Use the same secret as in wp-config.php (e.g. JWT_AUTH_SECRET_KEY)
# WORDPRESS_JWT_SECRET=
