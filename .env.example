NODE_ENV=development
PORT=3001
DATABASE_PATH=./data/student_ms.db

# REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Frontend origin(s) for CORS — comma-separated, e.g.:
# FRONTEND_URL=http://localhost:5173,https://mysite.local
FRONTEND_URL=http://localhost:5173

# Google OAuth (optional — leave empty to disable Google sign-in)
GOOGLE_CLIENT_ID=

# WordPress JWT — use the same secret as JWT_AUTH_SECRET_KEY in wp-config.php
WORDPRESS_JWT_SECRET=

# Default course codes assigned to new WordPress users (comma-separated)
# DEFAULT_COURSE_CODES=COURSE101,COURSE102

# ── Docker / nginx ──────────────────────────────────────────────────
# Path to the built frontend (used by docker-compose nginx volume)
# FRONTEND_DIST_PATH=../LMS-Frontend/dist

# Domain for nginx TLS (used in nginx.conf.template)
# LMS_DOMAIN=lms.smwebsystems.com

# Custom nginx ports (defaults: 80 / 443)
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
