# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_PATH=./data/student_ms.db

# CORS + Clerk authorized parties (comma-separated origins).
# Include every origin the frontend is served from. When the LMS is embedded in
# the marketing site via reverse proxy, add that origin too (Clerk runs
# first-party there), e.g.:
#   FRONTEND_URL=http://localhost:5173,http://localhost:3000,https://smwebsystems.com
FRONTEND_URL=http://localhost:5173

# Clerk (LMS owns authentication). Secret key verifies session tokens server-side.
CLERK_SECRET_KEY=
# Optional: explicit authorized parties for Clerk token verification.
# Defaults to FRONTEND_URL when unset. Set to the origins users sign in from,
# including the marketing site when embedded, e.g.:
#   CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://smwebsystems.com
CLERK_AUTHORIZED_PARTIES=

# Rate limiting (requests per IP per window; window = 15 minutes)
# Production defaults if unset: API 100, auth 20.
# Development defaults if unset: API 2000, auth 120 (still capped, but comfortable for HMR/Strict Mode).
API_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=

# Behind nginx, Railway, etc.: set so X-Forwarded-For is honored and limits apply per real client.
# TRUST_PROXY=1

# Email — Resend (https://resend.com). Leave blank to log emails to stdout instead.
RESEND_API_KEY=
# Sender address shown to recipients (must be a verified domain in Resend)
EMAIL_FROM=LMS <noreply@yourdomain.com>
# Human-readable name shown in email templates
LMS_NAME=SM Web Systems LMS
